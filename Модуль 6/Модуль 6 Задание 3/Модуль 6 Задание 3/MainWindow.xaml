<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск (название или автор):" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtSearch" Width="250" TextChanged="TxtSearch_TextChanged"/>
        </StackPanel>

        <DataGrid x:Name="GridBooks" Grid.Row="1" AutoGenerateColumns="True"/>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button Content="Взять в аренду" Click="BtnRent_Click" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Вернуть книгу" Click="BtnReturn_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>