<Window x:Class="FileManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файловый менеджер" Height="600" Width="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ComboBox x:Name="LeftDriveCombo" Grid.Row="0" Margin="0,0,0,5" SelectionChanged="LeftDriveCombo_SelectionChanged"/>
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Назад" Width="50" Grid.Column="0" Margin="0,0,3,0" Click="LeftBack_Click"/>
                    <Button Content="Вперед" Width="55" Grid.Column="1" Margin="0,0,5,0" Click="LeftForward_Click"/>
                    <TextBox x:Name="LeftPathBox" Grid.Column="2" IsReadOnly="True" Padding="3" VerticalContentAlignment="Center"/>
                </Grid>
                <ListView x:Name="LeftListView" Grid.Row="2" MouseDoubleClick="LeftListView_MouseDoubleClick" GotFocus="LeftListView_GotFocus" GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="170"/>
                            <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding FormattedSize}" Width="80"/>
                            <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding LastModified}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ComboBox x:Name="RightDriveCombo" Grid.Row="0" Margin="0,0,0,5" SelectionChanged="RightDriveCombo_SelectionChanged"/>
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Назад" Width="50" Grid.Column="0" Margin="0,0,3,0" Click="RightBack_Click"/>
                    <Button Content="Вперед" Width="55" Grid.Column="1" Margin="0,0,5,0" Click="RightForward_Click"/>
                    <TextBox x:Name="RightPathBox" Grid.Column="2" IsReadOnly="True" Padding="3" VerticalContentAlignment="Center"/>
                </Grid>
                <ListView x:Name="RightListView" Grid.Row="2" MouseDoubleClick="RightListView_MouseDoubleClick" GotFocus="RightListView_GotFocus" GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="170"/>
                            <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding FormattedSize}" Width="80"/>
                            <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding LastModified}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Копировать" Width="90" Margin="5" Click="Copy_Click"/>
            <Button Content="Вставить" Width="90" Margin="5" Click="Paste_Click"/>
            <Button Content="Переместить" Width="100" Margin="5" Click="Move_Click"/>
            <Button Content="Удалить" Width="90" Margin="5" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>