<Window x:Class="FileManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файловый менеджер (WPF)" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TreeView x:Name="FoldersTreeView" Grid.Column="0" Margin="0,0,10,0" SelectedItemChanged="Selest">
        </TreeView>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="CurrentPathTextBox" Grid.Row="0" IsReadOnly="True" Margin="0,0,0,10" Padding="5"/>
            <ListView x:Name="FilesListView" Grid.Row="1" Margin="0,0,0,10" MouseDoubleClick="MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="250"/>
                        <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Type}" Width="100"/>
                        <GridViewColumn Header="Дата изменения" DisplayMemberBinding="{Binding LastModified}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Копировать" Width="90" Margin="5,0" Click="Copy_Click"/>
                <Button Content="Переместить" Width="90" Margin="5,0" Click="Move_Click"/>
                <Button Content="Удалить" Width="90" Margin="5,0" Click="Delete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>