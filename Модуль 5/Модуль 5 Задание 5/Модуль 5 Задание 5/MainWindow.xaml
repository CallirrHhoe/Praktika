<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор WPF" Height="400" Width="300" ResizeMode="CanMinimize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TxtDisplay" Grid.Row="0" Text="0" FontSize="28" TextAlignment="Right" 
                 IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,0,10" Padding="5"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Content="C" Click="Clear_Click" Margin="2"/>
            <Button Grid.Row="0" Grid.Column="1" Content="/" Click="Operator_Click" Margin="2"/>
            <Button Grid.Row="0" Grid.Column="2" Content="*" Click="Operator_Click" Margin="2"/>
            <Button Grid.Row="0" Grid.Column="3" Content="-" Click="Operator_Click" Margin="2"/>
            <Button Grid.Row="1" Grid.Column="0" Content="7" Click="Number_Click" Margin="2"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Click="Number_Click" Margin="2"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Click="Number_Click" Margin="2"/>
            <Button Grid.Row="1" Grid.Column="3" Content="+" Click="Operator_Click" Margin="2"/>
            <Button Grid.Row="2" Grid.Column="0" Content="4" Click="Number_Click" Margin="2"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Click="Number_Click" Margin="2"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Click="Number_Click" Margin="2"/>
            <Button Grid.Row="2" Grid.Column="3" Content="=" Click="Equals_Click" Grid.RowSpan="2" Margin="2"/>
            <Button Grid.Row="3" Grid.Column="0" Content="1" Click="Number_Click" Margin="2"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Click="Number_Click" Margin="2"/>
            <Button Grid.Row="3" Grid.Column="2" Content="0" Click="Number_Click" Margin="2"/>
        </Grid>
    </Grid>
</Window>