<Window x:Class="EmuDisplayWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EmuDisplayWpf.ViewModels"
        xmlns:ctrl="clr-namespace:EmuDisplayWpf.Controls"
        xmlns:conv="clr-namespace:EmuDisplayWpf"
        Title="Эмулятор Дисплея (20x04)" 
        Height="720" Width="900"
        MinWidth="900" MaxWidth="900" 
        MinHeight="720" MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" 
        Background="#F0F0F0"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <conv:PixelColorConverter x:Key="PixelColorConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ВЕРХНИЙ РЯД: Дисплей и Макросы -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="660"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <ctrl:LcdDisplayControl Grid.Column="0" 
                                    LcdCore="{Binding LcdCore}" 
                                    Theme="{Binding CurrentTheme}" 
                                    Height="180" Margin="0,0,15,0"/>
            <GroupBox Grid.Column="1" Header="Макросы" Padding="10">
                <StackPanel>
                    <Button Content="Тестовая таблица" Command="{Binding Macro1Command}" Height="32" Margin="0,0,0,10"/>
                    <Button Content="{Binding Macro2Text}" Command="{Binding Macro2Command}" Height="32" Margin="0,0,0,10"/>
                    <Button Content="Сброс к заводским" Command="{Binding Macro3Command}" Height="32"/>
                </StackPanel>
            </GroupBox>
        </Grid>
        <!-- СРЕДНИЙ РЯД: Управление и CGRAM -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Левая колонка -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <GroupBox Header="Операции с текстом" Padding="10" Margin="0,0,0,10" Height="110">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="25" Margin="0,0,10,10" VerticalContentAlignment="Center" FontFamily="Consolas"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="Печать" Command="{Binding WriteTextCommand}" Height="25" Margin="0,0,0,10"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="Очистить" Command="{Binding ClearCommand}" Height="30"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Домой" Command="{Binding HomeCommand}" Height="30" Margin="10,0,0,0"/>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Контроллер дисплея (Режимы и Адресация)" Padding="10" Height="160">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <CheckBox Content="Экран" IsChecked="{Binding ChkDispOn}" Margin="0,0,20,0"/>
                            <CheckBox Content="Курсор" IsChecked="{Binding ChkCursorOn}" Margin="0,0,20,0"/>
                            <CheckBox Content="Мигание" IsChecked="{Binding ChkBlinkOn}"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Стр:" VerticalAlignment="Center" Padding="0"/>
                            <TextBox Grid.Column="1" Text="{Binding CursorRow}" Height="25" VerticalContentAlignment="Center"/>
                            <Label Grid.Column="2" Content="Столб:" VerticalAlignment="Center" Padding="0"/>
                            <TextBox Grid.Column="3" Text="{Binding CursorCol}" Height="25" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="4" Content="Уст. курсор" Command="{Binding SetCursorCommand}" Margin="5,0,0,0" Height="25"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀ Сдвиг экр." Command="{Binding ShiftLeftCommand}" Margin="0,0,5,0" Height="30"/>
                            <Button Grid.Column="1" Content="Сдвиг экр. ▶" Command="{Binding ShiftRightCommand}" Margin="5,0,0,0" Height="30"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <!-- Правая колонка (CGRAM) -->
            <GroupBox Grid.Column="1" Header="Редактор CGRAM (Собственные символы)" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding CgramGrid}" Margin="0,0,20,0" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" Rows="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="22" Height="22" BorderBrush="DarkGray" BorderThickness="1"
                                        Background="{Binding IsChecked, Converter={StaticResource PixelColorConverter}}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.TogglePixelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Label Content="Ячейка:" VerticalAlignment="Center" Padding="0,0,5,0"/>
                            <ComboBox SelectedIndex="{Binding CgramIndex}" Width="100" Height="25" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Символ 0"/>
                                <ComboBoxItem Content="Символ 1"/>
                                <ComboBoxItem Content="Символ 2"/>
                                <ComboBoxItem Content="Символ 3"/>
                                <ComboBoxItem Content="Символ 4"/>
                                <ComboBoxItem Content="Символ 5"/>
                                <ComboBoxItem Content="Символ 6"/>
                                <ComboBoxItem Content="Символ 7"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Content="Сохранить в CGRAM" Command="{Binding SaveCharCommand}" Height="32" Margin="0,0,0,10"/>
                        <Button Content="Напечатать символ" Command="{Binding InsertCharCommand}" Height="32" Margin="0,0,0,25"/>
                        <Button Content="Очистить сетку" Command="{Binding ClearGridCommand}" Height="32"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
        <!-- НИЖНИЙ РЯД: Лог и Тема -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="Анализатор командной шины (Лог интерфейса)" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ComboBox Grid.Row="0" ItemsSource="{Binding LogHistory}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,0,0,10"/>
                    <Label Grid.Row="1" Content="{Binding LogCountText}" Padding="0"/>
                </Grid>
            </GroupBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Цветовая схема:" VerticalAlignment="Center" Padding="0,0,10,0"/>
                <ComboBox SelectedIndex="{Binding CurrentTheme}" Width="160" Height="25" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Синяя (Blue/White)"/>
                    <ComboBoxItem Content="Зеленая (Green/Black)"/>
                    <ComboBoxItem Content="Желтая (Yellow/Black)"/>
                </ComboBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>