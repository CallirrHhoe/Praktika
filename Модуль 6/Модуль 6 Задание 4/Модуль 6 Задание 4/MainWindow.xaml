<Window x:Class="FinanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет финансов" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="GridFinance" AutoGenerateColumns="True" Margin="0,0,10,0"/>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Тип операции:"/>
            <ComboBox x:Name="CmbType" Margin="0,0,0,10">
                <ComboBoxItem Content="Доход"/>
                <ComboBoxItem Content="Расход"/>
            </ComboBox>

            <TextBlock Text="Сумма:"/>
            <TextBox x:Name="TxtSum" Margin="0,0,0,10"/>

            <TextBlock Text="Категория:"/>
            <TextBox x:Name="TxtCat" Margin="0,0,0,10"/>

            <TextBlock Text="Дата:"/>
            <TextBox x:Name="TxtDate" Margin="0,0,0,15"/>

            <Button Content="Добавить" Click="BtnAdd_Click" Margin="0,0,0,5"/>
            <Button Content="Изменить" Click="BtnUpdate_Click" Margin="0,0,0,5"/>
            <Button Content="Удалить" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>